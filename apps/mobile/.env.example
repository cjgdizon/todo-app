# Copy to .env.local (gitignored) for development. Both values are public by design:
# access is enforced by row-level security, not by hiding them.
#
# A phone cannot reach 127.0.0.1 on your computer. For local Supabase use the computer's address on
# your Wi-Fi, e.g. http://192.168.1.20:54321, and take the key from `pnpm db:status`.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
