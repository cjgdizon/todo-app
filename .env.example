# Copy to .env.local (web) / .env (mobile). Never commit real values.

# Supabase (public values are safe for clients; the service role key is NOT)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (Edge Function secrets, set with `supabase secrets set`; never in client env)
# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
